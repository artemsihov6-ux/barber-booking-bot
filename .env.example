# Запускаются те боты, для которых задан токен: Telegram, MAX или оба сразу.

# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID админов через запятую (узнать свой: отправь боту /id)
ADMIN_IDS=

# --- MAX ---
# Токен бота с платформы «MAX для партнёров» (раздел «Чат-боты»)
MAX_BOT_TOKEN=
# MAX ID админов через запятую (узнать свой: отправь боту в MAX /id)
MAX_ADMIN_IDS=

TIMEZONE=Europe/Moscow
DB_PATH=bookings.db
